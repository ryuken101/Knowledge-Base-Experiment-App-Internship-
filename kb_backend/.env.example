# Copy to .env and fill in. Point at the SAME SurrealDB instance as the task app
# (the KB reuses the task app's `user` table). db.py also falls back to
# ~/.config/taskcli/.env if no .env is found walking up from cwd.

SURREALDB_URL=http://YOUR_SURREALDB_HOST:8000
SURREALDB_USER=root
SURREALDB_PASS=your-password-here
SURREALDB_NS=main
SURREALDB_DB=main

# Which user owns the KB until user management/auth exists. A `user:<id>` record
# id; the row is seeded automatically on first write. Defaults to user:agent.
KB_USER=user:agent
