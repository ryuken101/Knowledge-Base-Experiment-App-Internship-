# Template — copy to `.env` and fill in real values. `.env` is git-ignored;
# NEVER put real credentials in this file (it is committed). Point at the SAME
# SurrealDB instance as the task app (the KB reuses its `user` table). db.py
# discovers `.env` by walking up from cwd, then falls back to
# ~/.config/taskcli/.env.

# --- SurrealDB connection (required) ---------------------------------------
# The backend signs in as ROOT (bypasses table permissions), so these grant
# full read/write. Prefer a TLS URL (https/wss) for any non-local instance.
SURREALDB_URL=http://xxx.x.x.x:xxxx
SURREALDB_USER=root
SURREALDB_PASS=your-password-here
SURREALDB_NS=main
SURREALDB_DB=main

# --- Knowledge base (optional) ---------------------------------------------
# Which user owns the KB until auth exists. A `user:<id>` record id; the row is
# seeded automatically on first write. Defaults to user:agent.
KB_USER=user:agent

# --- REST server (kb_api, optional) ----------------------------------------
# Host/port for `python -m kb_api`. Default to 127.0.0.1:8000.
KB_API_HOST=some-host-or-ip
KB_API_PORT=some-port
